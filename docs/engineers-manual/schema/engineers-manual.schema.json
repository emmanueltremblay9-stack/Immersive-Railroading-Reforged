{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/immersiverailroading/engineers-manual.schema.json",
  "title": "Immersive Railroading Engineer Manual Resource",
  "type": "object",
  "required": [
    "schema_version",
    "id"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "$ref": "#/$defs/resource_id"
    },
    "title": {
      "$ref": "#/$defs/translation_key"
    },
    "subtitle": {
      "$ref": "#/$defs/translation_key"
    },
    "description": {
      "$ref": "#/$defs/translation_key"
    },
    "icon": {
      "$ref": "#/$defs/resource_id"
    },
    "theme": {
      "$ref": "#/$defs/resource_id"
    },
    "landing_entry": {
      "$ref": "#/$defs/resource_id"
    },
    "default_locale": {
      "type": "string"
    },
    "fallback_locale": {
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/resource_id"
    },
    "parent": {
      "$ref": "#/$defs/resource_id"
    },
    "sort_order": {
      "type": "integer"
    },
    "keywords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/translation_key"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "related_entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource_id"
      }
    },
    "source_feature_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]+$"
      }
    },
    "technical": {
      "type": "boolean"
    },
    "hidden": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "translation_key": {
      "type": "string",
      "pattern": "^manual\\.immersiverailroading\\.[a-z0-9_.-]+$"
    },
    "page": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "heading",
            "text",
            "callout",
            "link",
            "item_stack",
            "table",
            "procedure"
          ]
        },
        "text": {
          "$ref": "#/$defs/translation_key"
        },
        "style": {
          "type": "string",
          "enum": [
            "info",
            "tip",
            "warning",
            "danger"
          ]
        },
        "entry": {
          "$ref": "#/$defs/resource_id"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://.+"
        }
      },
      "additionalProperties": true
    }
  }
}
